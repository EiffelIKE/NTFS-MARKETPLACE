# REST API base URL. MSW (spec 02) intercepts this same path, so one build works mocked or
# against a real API.
VITE_API_BASE_URL=/api

# Axios request timeout in milliseconds (positive integer).
VITE_API_TIMEOUT_MS=10000

# Enables the MSW mock API (spec 02). Must be spelled `true` or `false`; with `false` the build
# contains no mock code. There is no real backend, so the default is `true`.
VITE_ENABLE_MOCKS=true

# Socket.IO endpoint (spec 03). The client connects with the WebSocket transport only. With mocks
# on, MSW answers this URL in the page (@mswjs/socket.io-binding); nothing leaves the browser.
VITE_REALTIME_URL=wss://realtime.kurio.example

# Build time only: keeps the developer harness pages `/dev/ui-kit` and `/dev/realtime` in a
# production build (spec 14 §9). Off by default in builds, so the deploy does not ship them; the
# dev server always has them. The Playwright web server sets it to `true`.
# VITE_ENABLE_DEV_ROUTES=true
